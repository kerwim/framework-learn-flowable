<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://noctiflorous.cn/flowable">
    <process id="HolidayDemo2" name="HolidayDemo2" isExecutable="true">
        <documentation>人事审批与经理审批的候选人分配案例</documentation>
        <startEvent id="startEvent"/>
        <!-- 进入节点前，通过流程变量提供候选人账号；不设置固定审批人。 -->
        <userTask id="hrApproval" name="人事审批"
                  flowable:candidateUsers="${candidate1},${candidate2},${candidate3}"/>
        <userTask id="managerApproval" name="经理审批"
                  flowable:candidateUsers="${candidate4},${candidate5}"/>
        <endEvent id="endEvent"/>

        <sequenceFlow id="flowStartToHr" sourceRef="startEvent" targetRef="hrApproval"/>
        <sequenceFlow id="flowHrToManager" sourceRef="hrApproval" targetRef="managerApproval"/>
        <sequenceFlow id="flowManagerToEnd" sourceRef="managerApproval" targetRef="endEvent"/>
    </process>

    <bpmndi:BPMNDiagram id="HolidayDemo2Diagram">
        <bpmndi:BPMNPlane id="HolidayDemo2Plane" bpmnElement="HolidayDemo2">
            <bpmndi:BPMNShape id="startEventShape" bpmnElement="startEvent">
                <dc:Bounds x="80" y="100" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="hrApprovalShape" bpmnElement="hrApproval">
                <dc:Bounds x="260" y="68" width="120" height="100"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="managerApprovalShape" bpmnElement="managerApproval">
                <dc:Bounds x="560" y="68" width="120" height="100"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endEventShape" bpmnElement="endEvent">
                <dc:Bounds x="860" y="100" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="flowStartToHrEdge" bpmnElement="flowStartToHr">
                <di:waypoint x="116" y="118"/>
                <di:waypoint x="260" y="118"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flowHrToManagerEdge" bpmnElement="flowHrToManager">
                <di:waypoint x="380" y="118"/>
                <di:waypoint x="560" y="118"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flowManagerToEndEdge" bpmnElement="flowManagerToEnd">
                <di:waypoint x="680" y="118"/>
                <di:waypoint x="860" y="118"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>

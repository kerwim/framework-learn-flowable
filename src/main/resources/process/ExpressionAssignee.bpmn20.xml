<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://noctiflorous.cn/flowable">
    <process id="Example01" name="Example01" isExecutable="true">
        <documentation>固定审批人、流程变量表达式和 Spring Bean 方法表达式示例</documentation>
        <startEvent id="startEvent1"/>

        <!-- 固定审批人。 -->
        <userTask id="approvalUser1" name="审批用户1" flowable:assignee="zhangsan"/>
        <!-- 进入此节点前，需要设置流程变量 myAssign1。 -->
        <userTask id="approvalUser2" name="审批用户2" flowable:assignee="${myAssign1}"/>
        <!-- 需要 Spring Bean myBean，其 getAssignee() 方法返回审批人账号。 -->
        <userTask id="approvalUser3" name="审批用户3" flowable:assignee="${myBean.getAssignee()}"/>

        <endEvent id="endEvent1"/>
        <sequenceFlow id="flowStartToUser1" sourceRef="startEvent1" targetRef="approvalUser1"/>
        <sequenceFlow id="flowUser1ToUser2" sourceRef="approvalUser1" targetRef="approvalUser2"/>
        <sequenceFlow id="flowUser2ToUser3" sourceRef="approvalUser2" targetRef="approvalUser3"/>
        <sequenceFlow id="flowUser3ToEnd" sourceRef="approvalUser3" targetRef="endEvent1"/>
    </process>

    <bpmndi:BPMNDiagram id="Example01Diagram">
        <bpmndi:BPMNPlane id="Example01Plane" bpmnElement="Example01">
            <bpmndi:BPMNShape id="startEvent1Shape" bpmnElement="startEvent1">
                <dc:Bounds x="80" y="100" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="approvalUser1Shape" bpmnElement="approvalUser1">
                <dc:Bounds x="180" y="68" width="120" height="100"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="approvalUser2Shape" bpmnElement="approvalUser2">
                <dc:Bounds x="380" y="68" width="120" height="100"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="approvalUser3Shape" bpmnElement="approvalUser3">
                <dc:Bounds x="580" y="68" width="120" height="100"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endEvent1Shape" bpmnElement="endEvent1">
                <dc:Bounds x="780" y="100" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="flowStartToUser1Edge" bpmnElement="flowStartToUser1">
                <di:waypoint x="116" y="118"/>
                <di:waypoint x="180" y="118"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flowUser1ToUser2Edge" bpmnElement="flowUser1ToUser2">
                <di:waypoint x="300" y="118"/>
                <di:waypoint x="380" y="118"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flowUser2ToUser3Edge" bpmnElement="flowUser2ToUser3">
                <di:waypoint x="500" y="118"/>
                <di:waypoint x="580" y="118"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flowUser3ToEndEdge" bpmnElement="flowUser3ToEnd">
                <di:waypoint x="700" y="118"/>
                <di:waypoint x="780" y="118"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
